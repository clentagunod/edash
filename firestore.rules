// ============================================================================
// E-Dash tenant Firestore Security Rules
// Deploy: Firebase Console → Build → Firestore Database → Rules → paste →
// Publish. See SETUP_README.md.
//
// Role model: a user's role/status lives in users/{uid}. Every rule below
// looks that document up (get()) to decide what the caller may do — this is
// the real access control. The website's own role checks (isSchoolAdmin(),
// canManageLearners() in app-config.js) are for showing/hiding UI only and
// are NOT a security boundary by themselves.
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }
    function myRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().data.status == "Active"
        ? myProfile().data.role
        : "";
    }
    function isAdmin() { return myRole() == "School Admin"; }
    function isRegistrar() { return myRole() == "Registrar"; }
    function isTeacher() { return myRole() == "Teacher"; }
    function isStaff() { return myRole() in ["School Admin", "Registrar", "Teacher"]; }
    function validEduAiPreferences(data) {
      return data.keys().hasAll([
          "role", "model", "maxOutputTokens", "timeoutSeconds",
          "temperature", "historyMessages", "learnerNameLimit", "updatedAt"
        ])
        && data.keys().hasOnly([
          "role", "model", "maxOutputTokens", "timeoutSeconds",
          "temperature", "historyMessages", "learnerNameLimit", "updatedAt"
        ])
        && data.role == myRole()
        && data.model == "gemini-3.5-flash-lite"
        && data.maxOutputTokens in [256, 512, 768, 1024, 1536, 2048]
        && data.timeoutSeconds in [30, 45, 60, 90, 120]
        && data.temperature is number
        && data.temperature >= 0
        && data.temperature <= 0.6
        && data.historyMessages in [0, 2, 4, 6, 8]
        && data.learnerNameLimit in [0, 25, 50, 100, 150]
        && data.updatedAt is timestamp;
    }
    function teacherHasTrashAccess(trashItem) {
      let profileKeys = myProfile().data.get("teacherAssignmentSecurityKeys", []);
      let assignmentKey = trashItem.get("teacherAssignmentSecurityKey", "");
      return isTeacher()
        && profileKeys is list
        && assignmentKey is string
        && profileKeys.hasAny([assignmentKey]);
    }
    function validTeacherTrashAssignment(trashItem, yearId) {
      let learner = trashItem.get("learner", {});
      let learnerGrade = learner is map ? learner.get("gradeLevel", "") : "";
      let learnerSection = learner is map ? learner.get("section", "") : "";
      let assignmentKey = trashItem.get("teacherAssignmentSecurityKey", "");
      return learnerGrade is string
        && learnerSection is string
        && assignmentKey == yearId + "::" + learnerGrade + "::" + learnerSection
        && teacherHasTrashAccess(trashItem);
    }
    function teacherPromotionEnabled() {
      let togglesPath = /databases/$(database)/documents/settings/toggles;
      return exists(togglesPath)
        && get(togglesPath).data.get("canPromoteStudents", false) == true;
    }
    function validTeacherProgression(learnerId) {
      let learner = request.resource.data;
      let sourceYearValue = learner.get("progressionSourceSchoolYear", "");
      let sourceYear = sourceYearValue is string
        && sourceYearValue.matches("^\\d{4}-\\d{4}$")
        ? sourceYearValue
        : "__invalid__";
      let sourcePath = /databases/$(database)/documents/schoolYears/$(sourceYear)/learners/$(learnerId);
      let sourceExists = exists(sourcePath);
      let source = sourceExists ? get(sourcePath).data : {};
      let progressionType = learner.get("progressionType", "");
      return !learner.keys().hasAny(["progressionSourceSchoolYear"])
        || (teacherPromotionEnabled()
          && sourceYearValue is string
          && sourceYearValue.matches("^\\d{4}-\\d{4}$")
          && progressionType in ["promotion", "retention"]
          && sourceExists
          && ((progressionType == "promotion" && source.get("eosyStatus", "") == "Promoted")
            || (progressionType == "retention"
              && source.get("eosyStatus", "") == "Retained"
              && learner.get("gradeLevel", "") == source.get("gradeLevel", ""))));
    }
    function validTeacherTrashRestore(yearId, learnerId) {
      let trashId = request.resource.data.get("__trashRestoreId", "");
      let safeTrashId = trashId is string && trashId.size() > 0 ? trashId : "__invalid__";
      let trashPath = /databases/$(database)/documents/schoolYears/$(yearId)/trash/$(safeTrashId);
      let trashItem = exists(trashPath) ? get(trashPath).data : {};
      let originalLearner = trashItem.get("learner", {});
      return trashId is string
        && trashId.size() > 0
        && exists(trashPath)
        && trashItem.get("sourceCollection", "") == "learners"
        && trashItem.get("learnerId", "") == learnerId
        && originalLearner is map
        && teacherHasTrashAccess(trashItem)
        && request.resource.data.diff(originalLearner).affectedKeys().hasOnly(["__trashRestoreId"])
        && request.resource.data.diff(originalLearner).addedKeys().hasOnly(["__trashRestoreId"]);
    }
    function parentAccessEnabled() {
      let togglesPath = /databases/$(database)/documents/settings/toggles;
      return !exists(togglesPath)
        || get(togglesPath).data.get("canParentAccess", true) == true;
    }
    function validTeacherPrefs(prefs) {
      return prefs is map
        && prefs.keys().hasAll(["theme", "inspectLearner"])
        && prefs.keys().hasOnly(["theme", "inspectLearner"])
        && prefs.theme in ["Light", "Dark", "Dracula", "Monokai", "Beach", "Nord", "Forest", "ClentIndustries Theme"]
        && prefs.inspectLearner is bool;
    }
    function validPhotoURL(photoURL) {
      return photoURL is string
        && photoURL.size() <= 2048
        && (photoURL == "" || photoURL.matches("^https://res\\.cloudinary\\.com/[A-Za-z0-9_-]+/image/upload/.*$"));
    }
    function isUpdatingOwnAccountSettings(userId) {
      return isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "teacherPrefs", "photoURL"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["teacherPrefs"])
          || validTeacherPrefs(request.resource.data.teacherPrefs))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["photoURL"])
          || validPhotoURL(request.resource.data.photoURL));
    }

    // --- Users: anyone signed in can read their own profile, while staff can
    // read the directory for dropdowns like "adviser". Only an admin can
    // create/delete accounts or edit another user's profile. Every signed-in
    // account may edit its own name, validated personal preferences, and
    // validated Cloudinary profile photo URL, regardless of role.
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create: if isAdmin();
      allow delete: if isAdmin() && userId != request.auth.uid;
      allow update: if isAdmin();
      allow update: if isUpdatingOwnAccountSettings(userId);
      match /assignmentHistory/{schoolYear} {
        allow read: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
        allow write: if isAdmin();
      }
      match /eduaiSettings/{settingId} {
        allow read: if isStaff() && userId == request.auth.uid && settingId == "preferences";
        allow create, update: if isStaff()
          && userId == request.auth.uid
          && settingId == "preferences"
          && validEduAiPreferences(request.resource.data);
        allow delete: if isStaff() && userId == request.auth.uid && settingId == "preferences";
      }
      match /eduaiPrivate/{document=**} {
        allow read, write: if false;
      }
      match /eduaiUsage/{document=**} {
        allow read, write: if false;
      }
      match /eduaiRequests/{document=**} {
        allow read, write: if false;
      }
      match /eduaiConversations/{conversationId} {
        allow read: if isStaff() && userId == request.auth.uid;
        allow create: if isStaff()
          && userId == request.auth.uid
          && request.resource.data.keys().hasAll(["title", "createdAt", "updatedAt"])
          && request.resource.data.keys().hasOnly(["title", "createdAt", "updatedAt"])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if isStaff()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "updatedAt"])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 80
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isStaff() && userId == request.auth.uid;

        match /messages/{messageId} {
          allow read: if isStaff() && userId == request.auth.uid;
          allow create: if isStaff()
            && userId == request.auth.uid
            && request.resource.data.keys().hasAll(["role", "content", "createdAt"])
            && request.resource.data.keys().hasOnly(["role", "content", "createdAt"])
            && request.resource.data.role in ["user", "assistant"]
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 8000
            && request.resource.data.createdAt is timestamp;
          allow update: if false;
          allow delete: if isStaff() && userId == request.auth.uid;
        }
      }
    }

    // --- School-year data and its grade/section structure are year-scoped.
    match /schoolYears/{yearId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /learners/{learnerId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && (!isTeacher() || validTeacherProgression(learnerId) || validTeacherTrashRestore(yearId, learnerId));
        allow update, delete: if isStaff();
        allow get: if isAnonymous()
          && parentAccessEnabled()
          && resource.data.get("enrollmentStatus", "") != "TRANSFERRED_OUT"
          && resource.data.get("enrollmentStatus", "") != "DROPPED_OUT"
          && resource.data.get("eosyStatus", "") != "Dropped Out"
          && resource.data.get("transferOut", false) != true;
      }
      match /dropouts/{learnerId} {
        allow read, write: if isStaff();
      }
      match /transferredOut/{learnerId} {
        allow read, write: if isStaff();
      }
      match /trash/{trashId} {
        allow read: if isAdmin() || teacherHasTrashAccess(resource.data);
        allow create: if isAdmin() || validTeacherTrashAssignment(request.resource.data, yearId);
        allow update: if isAdmin();
        allow delete: if isAdmin() || teacherHasTrashAccess(resource.data);
      }
      match /grades/{gradeKey} {
        allow read: if isStaff();
        allow write: if isAdmin();
        match /sections/{sectionKey} {
          allow read: if isStaff();
          allow write: if isAdmin();
          match /teachers/{teacherUid} {
            allow read: if isStaff();
            allow write: if isAdmin();
          }
        }
      }
    }
    match /settings/{settingId} {
      // Backup exports list this entire collection. Authorize staff without
      // requiring the query to resolve a condition on each document ID.
      allow read: if isStaff() || (isSignedIn() && settingId != "eduai");
      allow write: if isAdmin();
      match /years/{schoolYear} {
        allow read: if isSignedIn() && settingId == "gradeTerms";
        allow write: if isAdmin() && settingId == "gradeTerms";
      }
    }
    // Login-page aggregate only. This document must never contain learner
    // names, IDs, or other personally identifiable information.
    match /publicStats/{statId} {
      allow get: if statId == "summary";
      allow list: if false;
      allow write: if isStaff() && statId == "summary";
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
