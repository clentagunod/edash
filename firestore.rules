// ============================================================================
// E-Dash tenant Firestore Security Rules
// Deploy: Firebase Console → Build → Firestore Database → Rules → paste →
// Publish. See SETUP_README.md.
//
// Role model: a user's role/status lives in users/{uid}. Every rule below
// looks that document up (get()) to decide what the caller may do — this is
// the real access control. The website's own role checks (isSchoolAdmin(),
// canManageLearners() in app-config.js) are for showing/hiding UI only and
// are NOT a security boundary by themselves.
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }
    function myRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().data.status == "Active"
        ? myProfile().data.role
        : "";
    }
    function isAdmin() { return myRole() == "School Admin"; }
    function isRegistrar() { return myRole() == "Registrar"; }
    function isTeacher() { return myRole() == "Teacher"; }
    function isStaff() { return myRole() in ["School Admin", "Registrar", "Teacher"]; }
    function validTeacherPrefs(prefs) {
      return prefs is map
        && prefs.keys().hasAll(["theme", "inspectLearner"])
        && prefs.keys().hasOnly(["theme", "inspectLearner"])
        && prefs.theme in ["Light", "Dark", "Dracula", "Monokai", "Beach", "Nord", "Forest", "ClentIndustries Theme"]
        && prefs.inspectLearner is bool;
    }
    function validPhotoURL(photoURL) {
      return photoURL is string
        && photoURL.size() <= 2048
        && (photoURL == "" || photoURL.matches("^https://res\\.cloudinary\\.com/[A-Za-z0-9_-]+/image/upload/.*$"));
    }
    function isUpdatingOwnAccountSettings(userId) {
      return isSignedIn()
        && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "teacherPrefs", "photoURL"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["teacherPrefs"])
          || validTeacherPrefs(request.resource.data.teacherPrefs))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["photoURL"])
          || validPhotoURL(request.resource.data.photoURL));
    }

    // --- Users: anyone signed in can read their own profile, while staff can
    // read the directory for dropdowns like "adviser". Only an admin can
    // create/delete accounts or edit another user's profile. Every signed-in
    // account may edit its own name, validated personal preferences, and
    // validated Cloudinary profile photo URL, regardless of role.
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isStaff();
      allow create: if isAdmin();
      allow delete: if isAdmin() && userId != request.auth.uid;
      allow update: if isAdmin();
      allow update: if isUpdatingOwnAccountSettings(userId);
      match /assignmentHistory/{schoolYear} {
        allow read: if isAdmin() || (isSignedIn() && userId == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    // --- School-year data and its grade/section structure are year-scoped.
    match /schoolYears/{yearId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /learners/{learnerId} {
        allow read, write: if isStaff();
        allow get: if isAnonymous()
          && resource.data.get("enrollmentStatus", "") != "TRANSFERRED_OUT"
          && resource.data.get("enrollmentStatus", "") != "DROPPED_OUT"
          && resource.data.get("eosyStatus", "") != "Dropped Out"
          && resource.data.get("transferOut", false) != true;
      }
      match /dropouts/{learnerId} {
        allow read, write: if isStaff();
      }
      match /transferredOut/{learnerId} {
        allow read, write: if isStaff();
      }
      match /grades/{gradeKey} {
        allow read: if isStaff();
        allow write: if isAdmin();
        match /sections/{sectionKey} {
          allow read: if isStaff();
          allow write: if isAdmin();
          match /teachers/{teacherUid} {
            allow read: if isStaff();
            allow write: if isAdmin();
          }
        }
      }
    }
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      match /years/{schoolYear} {
        allow read: if isSignedIn() && settingId == "gradeTerms";
        allow write: if isAdmin() && settingId == "gradeTerms";
      }
    }
    // Login-page aggregate only. This document must never contain learner
    // names, IDs, or other personally identifiable information.
    match /publicStats/{statId} {
      allow get: if statId == "summary";
      allow list: if false;
      allow write: if isStaff() && statId == "summary";
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
